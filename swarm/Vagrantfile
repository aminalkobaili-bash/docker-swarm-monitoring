Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  # Монтируем корень репо: стекам нужны /vagrant/db, /vagrant/nginx и /vagrant/monitoring
  config.vm.synced_folder "..", "/vagrant"
  # VirtualBox работает поверх Hyper-V (NEM) и грузится медленно: увеличиваем ожидание
  config.vm.boot_timeout = 900

  # Manager Node
  config.vm.define "manager01" do |manager|
    manager.vm.hostname = "manager01"
    manager.vm.network "private_network", ip: "192.168.56.10"
    manager.vm.provider "virtualbox" do |vb|
      vb.memory = "5120"
      vb.cpus = 4
    end
    manager.vm.provision "shell", path: "scripts/install-docker.sh"
    manager.vm.provision "shell", path: "scripts/init-manager.sh"
  end

  # Worker Node 1
  config.vm.define "worker01" do |worker|
    worker.vm.hostname = "worker01"
    worker.vm.network "private_network", ip: "192.168.56.11"
    worker.vm.provider "virtualbox" do |vb|
      vb.memory = "4096"
      vb.cpus = 4
    end
    worker.vm.provision "shell", path: "scripts/install-docker.sh"
    worker.vm.provision "shell", path: "scripts/join-worker.sh", args: ["192.168.56.11"]
  end

  # Worker Node 2
  config.vm.define "worker02" do |worker|
    worker.vm.hostname = "worker02"
    worker.vm.network "private_network", ip: "192.168.56.12"
    worker.vm.provider "virtualbox" do |vb|
      vb.memory = "4096"
      vb.cpus = 4
    end
    worker.vm.provision "shell", path: "scripts/install-docker.sh"
    worker.vm.provision "shell", path: "scripts/join-worker.sh", args: ["192.168.56.12"]
  end
end
